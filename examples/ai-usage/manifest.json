{
  "id": "com.cliperx.ai-usage",
  "name": "AI 用量",
  "version": "0.2.0",
  "apiVersion": 2,
  "author": "CliperX",
  "description": "通过本机 CodexBar 查看 Codex 或 Claude 用量、额度窗口和重置时间。",
  "license": "MIT",
  "symbol": "chart.bar",
  "sizes": [
    "wide",
    "small"
  ],
  "refreshSeconds": 60,
  "permissions": {
    "network": [],
    "openURL": false,
    "clipboardWrite": false,
    "systemMetrics": false,
    "aiUsage": true
  },
  "settings": [
    {
      "key": "provider",
      "title": "服务（codex / claude）",
      "default": "codex"
    }
  ]
}
