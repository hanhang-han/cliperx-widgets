{
  "id": "com.cliperx.focus-timer",
  "name": "专注计时",
  "version": "0.1.0",
  "apiVersion": 1,
  "author": "CliperX",
  "description": "原生倒计时，点击开始、暂停或重置，可配置专注时长。",
  "license": "MIT",
  "symbol": "timer",
  "sizes": ["small", "wide"],
  "refreshSeconds": 10,
  "permissions": { "network": [], "openURL": false, "clipboardWrite": false, "systemMetrics": false },
  "settings": [{ "key": "minutes", "title": "专注时长（分钟）", "default": "25" }]
}
